# Python cache and virtual envs
__pycache__/
*.py[cod]
.venv/
venv/

# Data artifacts — bronze and silver are always regenerated by the pipeline
data/bronze/
data/silver/
# Gold: only the generated file is ignored; the bundled example is tracked
data/gold/country_affordability.csv
# Legacy raw/processed dirs
data/raw/*.csv
data/raw/*.json
data/raw/*.xlsx
data/processed/*.csv
data/processed/*.parquet
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/*_template.csv
!data/processed/example_country_affordability.csv

# Jupyter
.ipynb_checkpoints/

# Test artifacts
.pytest_cache/
.pytest_tmp/
pytest-cache-files-*/

# OS/editor
.DS_Store
.vscode/

# Streamlit
.streamlit/
