# Python cache and virtual envs
__pycache__/
*.py[cod]
.venv/
venv/

# Data artifacts — bronze and silver are always regenerated by the pipeline
data/bronze/
data/silver/
# Gold: only the generated file is ignored; the bundled example is tracked
data/gold/country_affordability.csv
data/gold/*.json
# Raw: only template CSVs are tracked; real data files are ignored
data/raw/*.csv
data/raw/*.json
data/raw/*.xlsx
!data/raw/.gitkeep
!data/raw/*_template.csv

# Jupyter
.ipynb_checkpoints/

# Test artifacts
.pytest_cache/
.pytest_tmp/
pytest-cache-files-*/

# Build artifacts
*.egg-info/

# OS/editor
.DS_Store
.vscode/

# Streamlit — ignore secrets but track config
.streamlit/secrets.toml

